# Copy to .env.docker before running docker compose.
RK_PUBLIC_PORT=8780
RK_PUBLIC_BASE_URL=http://localhost:8780

# Optional. If omitted, the container generates one and stores it at
# /data/admin-key.txt. Never commit a real key.
# RK_API_KEY=change-me

RK_MAX_DOWNLOAD_MB=300
RK_MAX_CONCURRENT_JOBS=2
RK_JOB_TTL_HOURS=24

RK_BROWSER_CHANNEL=chromium
RK_BROWSER_LOCALE=zh-CN
RK_BROWSER_TIMEZONE=Asia/Shanghai
RK_BROWSER_VIEWPORT=1366x768
RK_BROWSER_LOGIN_VIEWPORT=1280x720
