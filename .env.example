RK_BIND_ADDRESS=0.0.0.0:8787
RK_PUBLIC_BASE_URL=http://localhost:8787
RK_STORAGE_DIR=storage
RK_MAX_DOWNLOAD_MB=300
RK_JOB_TTL_HOURS=24
RK_MAX_CONCURRENT_JOBS=2
RK_FFMPEG_PATH=ffmpeg
RK_BROWSER_PROBE_URL=http://127.0.0.1:8791
RK_BROWSER_PROBE_TIMEOUT_SECONDS=90

# Browser sidecar settings.
RK_BROWSER_HOST=127.0.0.1
RK_BROWSER_PORT=8791
RK_BROWSER_PROFILE_ROOT=storage/browser-profiles
RK_BROWSER_DEFAULT_PROFILE=admin_default
RK_BROWSER_TIMEOUT_MS=45000
RK_BROWSER_MAX_EVENTS=500
RK_BROWSER_MAX_CANDIDATES=50
# Set to 1 on a desktop host for manual login profile setup.
RK_BROWSER_HEADED=0

# Optional external adapter probes. These broaden site coverage when installed.
# RK_YTDLP_PATH=yt-dlp
# RK_YOU_GET_PATH=you-get
# RK_LUX_PATH=lux
# RK_STREAMLINK_PATH=streamlink
RK_EXTERNAL_PROBE_TIMEOUT_SECONDS=45

# Optional. If set, POST /api/jobs requires this value in x-api-key.
# RK_API_KEY=change-me
